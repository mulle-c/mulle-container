// generated by tools/cmake-graph.py - do not edit
digraph cmake_state {
   graph [rankdir=LR, bgcolor="white", fontname="Helvetica", fontsize=11,
          label=<<B>mulle-container &#8212; state this cmake config changes outside itself</B><BR/><FONT POINT-SIZE="9">every write that outlives the file making it &#183; search paths, flags, cache keys, the link+compile contract, the install tree</FONT>>,
